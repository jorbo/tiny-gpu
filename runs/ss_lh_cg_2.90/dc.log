# Design Compiler baseline synthesis for tiny-gpu (SAED32, worst-case SS 0.75V 125C by default)
# Run from syn/:  dc_shell -f dc_synth.tcl | tee dc.log
# Expects ../build/gpu.v from `make compile` and optionally ../build/gpu.saif
# Library corner. Worst case (SS 0.75 V 125 C) per the project spec; override e.g. "set CORNER tt0p78v25c"
if {![info exists CORNER]} { set CORNER ss0p75v125c }
set LIB_DB /usr/local/synopsys/pdk/SAED32_EDK/lib/stdcell_rvt/db_nldm/saed32rvt_$CORNER.db
/usr/local/synopsys/pdk/SAED32_EDK/lib/stdcell_rvt/db_nldm/saed32rvt_ss0p75v125c.db
set HVT_DB /usr/local/synopsys/pdk/SAED32_EDK/lib/stdcell_hvt/db_nldm/saed32hvt_$CORNER.db
/usr/local/synopsys/pdk/SAED32_EDK/lib/stdcell_hvt/db_nldm/saed32hvt_ss0p75v125c.db
set LVT_DB /usr/local/synopsys/pdk/SAED32_EDK/lib/stdcell_lvt/db_nldm/saed32lvt_$CORNER.db
/usr/local/synopsys/pdk/SAED32_EDK/lib/stdcell_lvt/db_nldm/saed32lvt_ss0p75v125c.db
set RTL    ../build/gpu.v
../build/gpu.v
set SAIF   ../build/gpu.saif
../build/gpu.saif
set TOP    gpu
gpu
# Multi-Vt: dc_shell -x "set USE_HVT 1" -f dc_synth.tcl
# Adds HVT cells so DC can swap non-critical paths to low-leakage cells; results go to separate dirs
# Fastest: dc_shell -x "set USE_HVT 1; set USE_LVT 1" -f dc_synth.tcl (LVT on critical paths, HVT elsewhere)
# Frequency sweep (sweep.sh) sets RUN_DIR so each period gets its own out/ and reports/
if {![info exists USE_HVT]} { set USE_HVT 0 }
if {![info exists USE_LVT]} { set USE_LVT 0 }
# LVT+HVT only: dc_shell -x "set USE_HVT 1; set USE_LVT 1; set NO_RVT 1" -f dc_synth.tcl
# RVT stays linked (SDC driving cell, wire load models) but no RVT cell is mapped
if {![info exists NO_RVT]}  { set NO_RVT 0 }
# Automatic clock gating: set CLOCK_GATING 1. DC puts an integrated clock-gating cell in front of
# register banks that only load under an enable, so their clock pins stop toggling while idle.
if {![info exists CLOCK_GATING]} { set CLOCK_GATING 0 }
set LIBS $LIB_DB
/usr/local/synopsys/pdk/SAED32_EDK/lib/stdcell_rvt/db_nldm/saed32rvt_ss0p75v125c.db
if {$USE_HVT} { lappend LIBS $HVT_DB }
/usr/local/synopsys/pdk/SAED32_EDK/lib/stdcell_rvt/db_nldm/saed32rvt_ss0p75v125c.db /usr/local/synopsys/pdk/SAED32_EDK/lib/stdcell_hvt/db_nldm/saed32hvt_ss0p75v125c.db
if {$USE_LVT} { lappend LIBS $LVT_DB }
/usr/local/synopsys/pdk/SAED32_EDK/lib/stdcell_rvt/db_nldm/saed32rvt_ss0p75v125c.db /usr/local/synopsys/pdk/SAED32_EDK/lib/stdcell_hvt/db_nldm/saed32hvt_ss0p75v125c.db /usr/local/synopsys/pdk/SAED32_EDK/lib/stdcell_lvt/db_nldm/saed32lvt_ss0p75v125c.db
if {[info exists RUN_DIR]} {
    set OUT $RUN_DIR/out
    set RPT $RUN_DIR/reports
} elseif {$USE_HVT} {
    set OUT  out_hvt
    set RPT  reports_hvt
} else {
    set OUT  out
    set RPT  reports
}
runs/ss_lh_cg_2.90/reports
file mkdir $OUT $RPT
set_app_var target_library $LIBS
/usr/local/synopsys/pdk/SAED32_EDK/lib/stdcell_rvt/db_nldm/saed32rvt_ss0p75v125c.db /usr/local/synopsys/pdk/SAED32_EDK/lib/stdcell_hvt/db_nldm/saed32hvt_ss0p75v125c.db /usr/local/synopsys/pdk/SAED32_EDK/lib/stdcell_lvt/db_nldm/saed32lvt_ss0p75v125c.db
